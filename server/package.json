{
  "name": "@fo/server",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "cross-env TZ=Asia/Bangkok vitest run",
    "golden:update": "cross-env TZ=Asia/Bangkok GOLDEN_UPDATE=1 vitest run test/golden.test.ts",
    "typecheck": "tsc -p .",
    "build": "node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "scrub": "esbuild bin/scrub-fixture.ts --bundle --platform=node --format=esm --outfile=dist/scrub-fixture.mjs --log-level=warning && node dist/scrub-fixture.mjs"
  },
  "dependencies": {
    "@fo/shared": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
